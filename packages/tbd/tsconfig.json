{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mts",
    "tests/**/*.cts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "docs/guidelines/scripts/check-rust-gate.mjs",
    "*.config.ts"
  ],
  "exclude": ["src/web"]
}
